# Batch files must keep CRLF: cmd.exe mis-parses LF-only .bat blocks and
# labels, and the failure is a wrong branch rather than a clean error.
*.bat text eol=crlf

# The shell launchers must keep LF for the opposite reason: a CR at the end of
# a shebang line makes the kernel look for an interpreter whose name ends in a
# carriage return, and the error names a file that plainly exists.
*.command text eol=lf
*.sh text eol=lf

# Pilot 01 freezes the exact source bytes for replay/audit. Keep this fixture
# LF-only on every platform so Windows checkout cannot rewrite the pinned file.
tests/fixtures/pilot_01/penguins.csv text eol=lf
